# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints/

# Data (large files not in git)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
*.fastq
*.fastq.gz
*.bam
*.bam.bai
*.vcf
*.fa.gz

# Models (weights too large for git - use HuggingFace/Git LFS)
*.pt
*.pth
*.safetensors
*.pb
*.pickle
*.h5
*.keras
!third_party/**/*.md

# IDE
.vscode/
.idea/
*.swp

# Logs
*.log
wandb/
